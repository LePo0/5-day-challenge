            "description": "Match par similarité de nom (avec variation orthographique)",
            "sirene_siret": "98765432100001",
            "rna_id": "W751000002",
            "expected_method": "BLOCKED_NAME",
            "expected_score_min": 0.78,
            "should_match": true
        },
        "scenario_3_address_match": {
            "description": "Match par adresse (nom vide dans SIRENE)",
            "sirene_siret": "33333333300001",
            "rna_id": "W330000001",
            "expected_method": "ADDRESS_MATCH",
            "expected_score_min": 0.85,
            "should_match": true
        },
        "scenario_4_exact_siret_different_cp": {
            "description": "SIRET exact mais CP différents (incohérence données sources)",
            "sirene_siret": "22222222200001",
            "rna_id": "W130000001",
            "expected_method": "EXACT_SIRET",
